# ==============================
# 一、Wiki 运行入口
# ==============================
# 说明：控制宿主机访问入口；默认仅绑定本机，避免开发环境意外暴露服务。
WEB_PORT=3000
WEB_BIND_HOST=127.0.0.1
WEB_PUBLIC_HOST=127.0.0.1
WEB_PUBLIC_ORIGIN=http://127.0.0.1:3000

# ==============================
# 二、PostgreSQL（关系数据库 + pgvector 向量库）
# ==============================
# 说明：同一个 PostgreSQL 实例承担两个角色：
#   1. 关系数据库：存 Wiki 节点、用户、聊天日志、RagDocument 等表
#   2. pgvector 向量库：rag_chunks.embedding 列存 1024 维文档向量，用 cosine_distance 检索
# 注意：Docker 容器内运行时 DB_HOST 会被 compose 覆盖为 postgres；本地直连后端用 127.0.0.1。
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me-in-local-env
DB_NAME=postgres

# ==============================
# 三、S3 / RustFS 对象存储
# ==============================
# 说明：存原始文件（上传的 md/pdf/docx 等）。Docker 内运行时 S3_ENDPOINT_URL 会被覆盖为 http://rustfs:9000。
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-in-local-env
S3_REGION=us-east-1
S3_BUCKET_NAME=wiki-bucket

# ==============================
# 四、RAG（检索增强生成）
# ==============================
# ── LLM 大语言模型（DeepSeek，OpenAI 兼容）──
LLM_API_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-with-deepseek-api-key
LLM_MODEL=deepseek-v4-flash

# ── Embedding 向量化（阿里百炼 text-embedding-v3）──
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=replace-with-dashscope-api-key
EMBEDDING_MODEL=text-embedding-v3

# ── 文本切分（splitter）──
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── 检索与生成 ──
TOP_K=5
SYSTEM_PROMPT=
RAG_SYNC_MAX_RETRIES=3

# ── 向量相关（与 PostgreSQL pgvector 对应）──
VECTOR_DIM=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_CHARS=2000

# ── Redis / Celery 消息队列（RAG 入库任务调度）──
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
RAG_TASK_MAX_RETRIES=3
RAG_TASK_RETRY_DELAY_SECONDS=30

# ==============================
# 五、认证与管理后台
# ==============================
# 说明：JWT 签名密钥，生产环境务必替换为高强度随机值。
JWT_SECRET=change-me-in-local-env
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-local-env

# 说明：应用基础配置。
APP_NAME="Wiki Backend"
DEBUG=true
CORS_ORIGINS='["*"]'

# ==============================
# 六、Wiki Web（前端）
# ==============================
# 说明：NEXT_PUBLIC_* 会被 Next.js 写入浏览器端产物；Wiki 数据默认通过 wiki-web 代理访问后端。
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000/wiki-api

# 说明：聊天面板由后端自研 RAG 完成向量检索 + LLM 流式回答。
NEXT_PUBLIC_CHATBOT_ASSISTANT_NAME=智能学习助手
NEXT_PUBLIC_CHATBOT_GREETING=你好，我可以帮你查询当前知识库内容。
NEXT_PUBLIC_CHATBOT_PLACEHOLDER=输入你的问题...
NEXT_PUBLIC_CHATBOT_DEFAULT_MESSAGES="介绍一下这个知识库,我可以如何使用这个 Wiki"
NEXT_PUBLIC_CHATBOT_PROMPT=
NEXT_PUBLIC_CHATBOT_MODEL=
NEXT_PUBLIC_CHATBOT_TEMPERATURE=
