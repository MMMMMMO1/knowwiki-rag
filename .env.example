# ==============================
# Wiki 运行入口配置
# ==============================
# 说明：控制宿主机访问入口；默认仅绑定本机，避免开发环境意外暴露服务。
WEB_PORT=3000
WEB_BIND_HOST=127.0.0.1
WEB_PUBLIC_HOST=127.0.0.1
WEB_PUBLIC_ORIGIN=http://127.0.0.1:3000

# 说明：仅 dev 模式下用于直接访问 AnythingLLM 调试端口；正式访问仍走 wiki-web 代理。
ANYTHINGLLM_PORT=3001
ANYTHINGLLM_BIND_HOST=127.0.0.1

# ==============================
# Wiki Backend 基础配置
# ==============================
# 说明：FastAPI 应用名称与调试模式；生产环境应设置 DEBUG=false。
APP_NAME="Wiki Backend"
DEBUG=true

# 说明：Pydantic 会把 JSON 数组解析为 Python list；生产环境建议改为明确域名。
CORS_ORIGINS='["*"]'

# 说明：JWT 签名与验签所使用的密钥；必须在本地 .env 中替换为高强度随机值。
JWT_SECRET=change-me-in-local-env

# 说明：仅在数据库没有任何用户时用于初始化第一个数据库管理员账户；初始化后请通过管理后台改密或禁用默认值。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-local-env

# ==============================
# PostgreSQL 配置
# ==============================
# 说明：Docker Compose 内部运行时 DB_HOST 会覆盖为 postgres；本地直连后端可使用 127.0.0.1。
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me-in-local-env
DB_NAME=postgres

# ==============================
# S3 / RustFS 对象存储配置
# ==============================
# 说明：Docker Compose 内部运行时 S3_ENDPOINT_URL 会覆盖为 http://rustfs:9000。
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-in-local-env
S3_REGION=us-east-1
S3_BUCKET_NAME=wiki-bucket

# ==============================
# AnythingLLM 同步配置
# ==============================
# 说明：这里是 Wiki Backend 调用 AnythingLLM API 的配置，不是 AnythingLLM 自身自动生成的 .env。
ANYTHINGLLM_API_URL=http://127.0.0.1:3001
ANYTHINGLLM_API_KEY=replace-with-anythingllm-api-key
ANYTHINGLLM_WORKSPACE_SLUG=test
ANYTHINGLLM_SYNC_MAX_RETRIES=3

# ==============================
# Wiki Web API 地址
# ==============================
# 说明：NEXT_PUBLIC_* 会被 Next.js 写入浏览器端产物；Wiki 数据默认通过 wiki-web 代理访问后端。
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000/wiki-api

# ==============================
# Wiki Web 当前聊天面板配置
# ==============================
# 说明：当前聊天实现是 WikiChatPanel，浏览器调用 /api/chat，再由后端在内网访问 AnythingLLM。
NEXT_PUBLIC_CHATBOT_EMBED_ID=
NEXT_PUBLIC_CHATBOT_USERNAME=
NEXT_PUBLIC_CHATBOT_ASSISTANT_NAME=智能学习助手
NEXT_PUBLIC_CHATBOT_GREETING=你好，我可以帮你查询当前知识库内容。
NEXT_PUBLIC_CHATBOT_PLACEHOLDER=输入你的问题...
NEXT_PUBLIC_CHATBOT_DEFAULT_MESSAGES="介绍一下这个知识库,我可以如何使用这个 Wiki"
NEXT_PUBLIC_CHATBOT_PROMPT=
NEXT_PUBLIC_CHATBOT_MODEL=
NEXT_PUBLIC_CHATBOT_TEMPERATURE=
