# 说明：
# 前端使用多阶段构建，先安装依赖并执行 next build，
# 最终运行阶段只保留 standalone 产物，减少镜像体积。
FROM node:22-bookworm-slim AS deps

WORKDIR /app

# 说明：
# package-lock.json 已存在，使用 npm ci 可以获得可重复的依赖安装结果。
COPY package.json package-lock.json ./
RUN npm ci

FROM deps AS builder

# 说明：
# NEXT_PUBLIC_* 会被 Next.js 写入浏览器端产物，
# 因此必须在构建阶段由 compose 传入正确的公开配置。
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_CHATBOT_ASSISTANT_NAME
ARG NEXT_PUBLIC_CHATBOT_GREETING
ARG NEXT_PUBLIC_CHATBOT_PLACEHOLDER
ARG NEXT_PUBLIC_CHATBOT_DEFAULT_MESSAGES
ARG NEXT_PUBLIC_CHATBOT_PROMPT
ARG NEXT_PUBLIC_CHATBOT_MODEL
ARG NEXT_PUBLIC_CHATBOT_TEMPERATURE
ENV NEXT_PUBLIC_API_URL="${NEXT_PUBLIC_API_URL}" \

    NEXT_PUBLIC_CHATBOT_ASSISTANT_NAME="${NEXT_PUBLIC_CHATBOT_ASSISTANT_NAME}" \
    NEXT_PUBLIC_CHATBOT_GREETING="${NEXT_PUBLIC_CHATBOT_GREETING}" \
    NEXT_PUBLIC_CHATBOT_PLACEHOLDER="${NEXT_PUBLIC_CHATBOT_PLACEHOLDER}" \
    NEXT_PUBLIC_CHATBOT_DEFAULT_MESSAGES="${NEXT_PUBLIC_CHATBOT_DEFAULT_MESSAGES}" \
    NEXT_PUBLIC_CHATBOT_PROMPT="${NEXT_PUBLIC_CHATBOT_PROMPT}" \
    NEXT_PUBLIC_CHATBOT_MODEL="${NEXT_PUBLIC_CHATBOT_MODEL}" \
    NEXT_PUBLIC_CHATBOT_TEMPERATURE="${NEXT_PUBLIC_CHATBOT_TEMPERATURE}"

COPY . .
RUN npm run build

FROM node:22-bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# 说明：
# 运行阶段同样保留环境变量，供 Next.js 服务端路由读取。
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_CHATBOT_ASSISTANT_NAME
ARG NEXT_PUBLIC_CHATBOT_GREETING
ARG NEXT_PUBLIC_CHATBOT_PLACEHOLDER
ARG NEXT_PUBLIC_CHATBOT_DEFAULT_MESSAGES
ARG NEXT_PUBLIC_CHATBOT_PROMPT
ARG NEXT_PUBLIC_CHATBOT_MODEL
ARG NEXT_PUBLIC_CHATBOT_TEMPERATURE
ENV NEXT_PUBLIC_API_URL="${NEXT_PUBLIC_API_URL}" \
    NEXT_PUBLIC_CHATBOT_ASSISTANT_NAME="${NEXT_PUBLIC_CHATBOT_ASSISTANT_NAME}" \
    NEXT_PUBLIC_CHATBOT_GREETING="${NEXT_PUBLIC_CHATBOT_GREETING}" \
    NEXT_PUBLIC_CHATBOT_PLACEHOLDER="${NEXT_PUBLIC_CHATBOT_PLACEHOLDER}" \
    NEXT_PUBLIC_CHATBOT_DEFAULT_MESSAGES="${NEXT_PUBLIC_CHATBOT_DEFAULT_MESSAGES}" \
    NEXT_PUBLIC_CHATBOT_PROMPT="${NEXT_PUBLIC_CHATBOT_PROMPT}" \
    NEXT_PUBLIC_CHATBOT_MODEL="${NEXT_PUBLIC_CHATBOT_MODEL}" \
    NEXT_PUBLIC_CHATBOT_TEMPERATURE="${NEXT_PUBLIC_CHATBOT_TEMPERATURE}"

# 说明：standalone 目录包含 server.js 和必要 node_modules；.next/static 需要额外复制，保证静态资源正常返回。
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3000

CMD ["node", "server.js"]
